# Copied to .env by `just setup <extra> local`. Machine-specific settings only; never commit .env.
META_PFN_SETUP=local
META_PFN_TORCH_EXTRA=cpu
# META_PFN_RUNS_ROOT=/path/to/runs        default: <repo>/runs
# META_PFN_DATA_ROOT=/path/to/data        default: <repo>/data
META_PFN_REMOTE_HOST=<ssh-alias>
META_PFN_REMOTE_DIR=PycharmProjects/meta-pfn
# META_PFN_MLFLOW_URI=sqlite:////path/to/mlflow.db   default: <repo>/mlflow.db
# pfn-repro's large checkpoints (docs/checkpoints.md there): the directory holding pfn_large.pt etc.
PFN_REPRO_CKPT_ROOT=/home/ruhkopf/PycharmProjects/pfn-repro/checkpoints
